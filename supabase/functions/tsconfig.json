{
  "compilerOptions": {
    "lib": ["es2021", "dom"],
    "types": ["https://deno.land/std@0.208.0/http/server.ts"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node"
  },
  "include": ["**/*.ts"]
}